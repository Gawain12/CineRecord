# Project-Specific Ignores
# Ignore user-specific configuration, but not the template
config/config.py
!config/config.py.template
!config/config.json.template

# Ignore temporary output files from scrapers
scrapers/*.csv

# Ignore user-specific data files, but keep the shared db_imdb.csv
data/**/*.csv
!data/db_imdb.csv
data/*.db
data/*_cache.json
data/*_logs.json
data/sync_failure_cache.json
data/task_logs.json
data/letterboxd_platform_mapping.json

# General Ignores
*.log
*.swp
tmp/
CLAUDE.md
CLAUDE.zh.md

# Build artifacts
build/
dist/
dist_temp*/
*.pyz
*.egg-info/

# Archive folder (old/unused files)
_archive/

